# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Postgres do Supabase (Connect > Transaction pooler, porta 6543). Só no servidor.
# Vazio = modo local: um Postgres embutido em .dados-locais/ com dados de exemplo.
DATABASE_URL=

# Supabase (Project Settings > API): login Google e atualizações ao vivo do painel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile. Para desenvolvimento local, use as chaves de teste da Cloudflare
# (sempre aprovam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Fase 4
RESEND_API_KEY=

# TODO(pedro): domínio definitivo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
