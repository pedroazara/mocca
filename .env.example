# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Postgres do Supabase (Connect > Transaction pooler, porta 6543). Só no servidor.
# Vazio = modo local: um Postgres embutido em .dados-locais/ com dados de exemplo.
DATABASE_URL=

# Supabase (Project Settings > API): login e atualizações ao vivo do painel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta, só no servidor: cria a conta no primeiro acesso e apaga a antiga quando o admin
# troca o e-mail de alguém. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. Para desenvolvimento local, use as chaves de teste da Cloudflare
# (sempre aprovam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Secreta, só no servidor: senha de app da conta moccaufla@gmail.com (ver README).
# Vazio = nenhum e-mail sai, só fica registrado no log.
GMAIL_APP_PASSWORD=

# Aba Arquivos: a pasta do projeto no Google Drive (ver README, "Arquivos do Google Drive").
# Link da pasta (https://drive.google.com/drive/folders/...) ou só o id dela.
GOOGLE_DRIVE_FOLDER=
# Secreta, só no servidor: o JSON inteiro da chave da conta de serviço (ou o JSON em base64).
# A pasta precisa estar compartilhada com o e-mail da conta, como leitor.
# Vazias = no modo local, a aba mostra uma pasta de exemplo; num deploy, avisa que falta ligar.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Secreta, só no servidor: protege o lembrete diário da véspera do prazo (/api/cron/lembretes).
# A Vercel manda este valor sozinha nas chamadas agendadas (vercel.json). Vazia = a rota não responde.
CRON_SECRET=

# TODO(pedro): domínio definitivo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
